# Copy to .env.local and fill in. Never commit .env.local.

# Your local PostgreSQL superuser. Used only by db:setup and bootstrap:developer.
DATABASE_ADMIN_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/postgres

# First Developer account
BOOTSTRAP_DEVELOPER_EMAIL=you@gmail.com

# The Gmail account that sends sign-in codes, and its App Password from
# Google Account > Security (needs 2-Step Verification).
# In development you can leave these empty: codes then print in the server terminal.
# SMTP_USER=sender@gmail.com
# SMTP_APP_PASSWORD=

# Rate limits. Start it with: docker compose -f docker/compose.dev.yml up -d
REDIS_URL=redis://127.0.0.1:6379

# Local AI. Optional: these are the defaults.
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_CHAT_MODEL=llama3.2:3b

# npm run db:setup adds DATABASE_URL, DATABASE_AUTH_URL, BETTER_AUTH_SECRET and BETTER_AUTH_URL.
