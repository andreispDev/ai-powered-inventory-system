# Copy to .env.local and fill in. Never commit .env.local.

# Your local PostgreSQL superuser. Used only by db:setup and bootstrap:developer.
DATABASE_ADMIN_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/postgres

# First Developer account
BOOTSTRAP_DEVELOPER_EMAIL=you@example.com

# From Google Cloud Console. Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: restrict sign-in to one Google Workspace domain
# GOOGLE_ALLOWED_HD=example.com

# npm run db:setup adds DATABASE_URL, DATABASE_AUTH_URL, BETTER_AUTH_SECRET and BETTER_AUTH_URL.
